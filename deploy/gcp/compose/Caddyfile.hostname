# Used when EDGEQUAKE_HOSTNAME is set.
# Do not prefix the site with http:// — that disables automatic HTTPS for the name
# (https://caddyserver.com/docs/automatic-https). Caddy obtains a public cert
# (Let's Encrypt, then ZeroSSL) and redirects :80 → HTTPS (LAW-148-13).

{
	email {$CADDY_ACME_EMAIL}
}

import snippets.caddy

{$EDGEQUAKE_HOSTNAME} {
	log {
		output stdout
		format json
	}
	header {
		Strict-Transport-Security "max-age=15552000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "SAMEORIGIN"
		-Server
	}
	import app
}
